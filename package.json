{
  "name": "stokmate",
  "private": true,
  "version": "0.1.0",
  "description": "StokMate take-home assignment — web + mobile clients over the provided StokMate API",
  "workspaces": [
    "shared",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:mobile": "npm run start --workspace mobile",
    "build:web": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace shared"
  },
  "engines": {
    "node": ">=20"
  }
}
